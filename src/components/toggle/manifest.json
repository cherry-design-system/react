{
  "name": "toggle",
  "class": "cherry-toggle",
  "attributes": {
    "size": ["sm", "md", "lg"]
  },
  "states": [":checked", ":disabled", ":focus-visible", "data-invalid"],
  "parts": [
    "cherry-toggle__input",
    "cherry-toggle__track",
    "cherry-toggle__thumb",
    "cherry-toggle__label"
  ],
  "category": "Forms",
  "accessibility": "role=switch: Space toggles and on/off is announced. The `label` names it.",
  "example": "<Toggle label=\"Email notifications\" defaultChecked />"
}
