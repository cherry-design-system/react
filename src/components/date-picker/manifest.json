{
  "name": "date-picker",
  "class": "cherry-date-picker",
  "attributes": {
    "size": ["sm", "md", "lg"]
  },
  "states": [
    "data-open",
    "data-invalid",
    "data-disabled",
    "data-full-width",
    ":popover-open",
    ":focus-visible",
    ":hover"
  ],
  "parts": [
    "cherry-date-picker__trigger",
    "cherry-date-picker__icon",
    "cherry-date-picker__value",
    "cherry-date-picker__placeholder",
    "cherry-date-picker__popover"
  ],
  "category": "Pickers",
  "accessibility": "The trigger opens a dialog and focus moves into the Calendar grid; Escape closes and returns focus to the trigger. Label it with Field.",
  "example": "<Field label=\"Due date\">\n  <DatePicker locale=\"en-US\" onChange={setDue} fullWidth />\n</Field>"
}
