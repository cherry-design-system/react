{
  "name": "button",
  "class": "cherry-button",
  "attributes": {
    "variant": ["primary", "secondary", "outline", "ghost", "accent"],
    "size": ["sm", "md", "lg"]
  },
  "states": [
    "disabled",
    "data-loading",
    "data-full-width",
    ":focus-visible",
    ":hover",
    ":active"
  ],
  "parts": ["cherry-button__label", "cherry-button__icon"],
  "category": "Actions",
  "accessibility": "Native <button> with a visible focus ring. `loading` sets aria-busy and keeps the label readable. For icon-only actions use IconButton.",
  "example": "<Button variant=\"primary\" leadingIcon={<Plus />}>New project</Button>\n<Button variant=\"outline\" loading>Saving</Button>"
}
