{
  "name": "otp-input",
  "class": "cherry-otp-input",
  "attributes": {
    "size": ["sm", "md", "lg"]
  },
  "states": [
    "data-invalid",
    "data-disabled",
    "data-separator",
    "data-filled",
    ":focus-within"
  ],
  "parts": [
    "cherry-otp-input__slot",
    "cherry-otp-input__char",
    "cherry-otp-input__caret",
    "cherry-otp-input__separator"
  ],
  "category": "Forms",
  "accessibility": "A named group; each slot is labelled \"Character n of length\" (`slotLabel`). Typing advances, Backspace goes back, arrows/Home/End move, paste fills every slot.",
  "example": "<Field label=\"Verification code\">\n  <OTPInput length={6} separator onComplete={verify} />\n</Field>"
}
