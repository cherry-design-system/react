{
  "name": "number-field",
  "class": "cherry-number-field",
  "attributes": {
    "size": ["sm", "md", "lg"]
  },
  "states": [
    "data-invalid",
    "data-disabled",
    ":focus-within",
    ":hover",
    ":disabled"
  ],
  "parts": [
    "cherry-number-field__input",
    "cherry-number-field__button",
    "cherry-number-field__decrement",
    "cherry-number-field__increment"
  ],
  "category": "Forms",
  "accessibility": "role=spinbutton: Up/Down step, PageUp/PageDown use `largeStep`, Home/End go to min/max. The steppers are labelled buttons (`decrementLabel`, `incrementLabel`).",
  "example": "<Field label=\"Guests\">\n  <NumberField min={1} max={8} defaultValue={2} />\n</Field>"
}
