{
  "name": "pagination",
  "class": "cherry-pagination",
  "attributes": {
    "variant": ["full", "compact"]
  },
  "states": [
    "[aria-current=\"page\"]",
    "[aria-disabled=\"true\"]",
    ":hover",
    ":active",
    ":focus-visible"
  ],
  "parts": [
    "cherry-pagination__list",
    "cherry-pagination__item",
    "cherry-pagination__link",
    "cherry-pagination__step",
    "cherry-pagination__ellipsis",
    "cherry-pagination__status"
  ],
  "category": "Navigation",
  "accessibility": "A nav landmark; give each one a distinct name (`labels.nav`) when a page has two. The current page is aria-current=page; Previous/Next are labelled. `getHref` renders links and needs no JS.",
  "example": "<Pagination page={page} totalPages={10} onPageChange={setPage} />"
}
