{
  "name": "avatar",
  "class": "cherry-avatar",
  "attributes": {
    "size": ["sm", "md", "lg", "xl"],
    "color": ["neutral", "accent", "ai"],
    "status": ["online", "away", "busy", "offline"]
  },
  "states": ["data-loaded"],
  "parts": [
    "cherry-avatar__fallback",
    "cherry-avatar__image",
    "cherry-avatar__status"
  ],
  "category": "Data display",
  "accessibility": "role=img named after the person when it adds information; decorative (hidden) next to a visible name. `status` is announced through `statusLabels`.",
  "example": "<Avatar name=\"Ada Lovelace\" src=\"/ada.jpg\" status=\"online\" />"
}
