{
  "name": "toggle-group",
  "class": "cherry-toggle-group",
  "attributes": {
    "type": ["single", "multiple"],
    "size": ["sm", "md"]
  },
  "states": [
    "data-ready",
    "aria-checked",
    "aria-pressed",
    "aria-disabled",
    ":disabled",
    ":focus-visible",
    ":hover"
  ],
  "parts": ["cherry-toggle-group__indicator", "cherry-toggle-group__item"],
  "category": "Forms",
  "accessibility": "`type=\"single\"` is a radiogroup (arrows, Home/End move and select); `type=\"multiple\"` is toggle buttons with aria-pressed. Label icon-only items and name the group.",
  "example": "<ToggleGroup type=\"single\" defaultValue=\"week\" aria-label=\"Range\">\n  <ToggleGroupItem value=\"day\">Day</ToggleGroupItem>\n  <ToggleGroupItem value=\"week\">Week</ToggleGroupItem>\n</ToggleGroup>"
}
