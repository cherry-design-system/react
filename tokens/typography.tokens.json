{
  "$description": "Typography tokens (Geist / Geist Mono), mirrored from the Figma text styles.",
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Geist", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    }
  },
